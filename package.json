{
  "name": "@oriworks/monorepo-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "storybook": "turbo run storybook --filter=@oriworks/design-system",
    "build-storybook": "turbo run build-storybook --filter=@oriworks/design-system",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spellcheck": "cspell --no-progress --show-suggestions \"**\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "eslint --flag v10_config_lookup_from_file --fix --no-warn-ignored",
    "*.{json,md,mdx,css,yml,yaml}": "prettier --write",
    "*": "cspell --no-progress --no-must-find-files --show-suggestions"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@cspell/dict-pt-pt": "^3.0.8",
    "@oriworks/eslint-config": "workspace:*",
    "@oriworks/prettier-config": "workspace:*",
    "cspell": "^10.4.1",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
